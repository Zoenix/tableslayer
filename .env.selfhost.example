# Copy to .env.selfhost and adjust. Used by docker-compose.selfhost.yml.

# The exact URL you type into the browser (LAN IP, hostname, or your reverse-proxy domain).
# Used for invite links and as the base for uploaded file URLs.
BASE_URL=http://192.168.1.50:3000

# Shared secret between the web and realtime containers. Generate one with:
#   openssl rand -hex 32
INTERNAL_API_TOKEN=

# Host port for the web UI
TABLESLAYER_PORT=3000

# Where the database, uploads and realtime state live on the host
TABLESLAYER_DATA=./tableslayer-data

# Use a prebuilt image instead of building locally (see SELFHOSTING.md)
# TABLESLAYER_IMAGE=ghcr.io/<your-github-user>/tableslayer:latest

TZ=Europe/Berlin

# ---- Optional ----
# Transactional email (Cloudflare Email Service). Without it, no emails are sent
# and new accounts are verified automatically.
CLOUDFLARE_EMAIL_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
EMAIL_FROM=
# Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
